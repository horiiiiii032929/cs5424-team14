\echo ===== T6 check: per-merchant totals, old query against rollup version (expect only_in_old = only_in_new = 0) =====
===== T6 check: per-merchant totals, old query against rollup version (expect only_in_old = only_in_new = 0) =====
WITH old_t6 AS (SELECT merchant_id, COUNT(*) AS order_count, SUM(total_amount) AS revenue FROM orders WHERE created_at >= :'window_start'::timestamp AND created_at < :'window_end'::timestamp GROUP BY merchant_id), new_t6 AS (SELECT merchant_id, SUM(order_count)::bigint AS order_count, SUM(revenue) AS revenue FROM (SELECT merchant_id, SUM(order_count)::bigint AS order_count, SUM(revenue) AS revenue FROM merchant_daily_sales WHERE sales_day >= :'first_whole_day'::date AND sales_day < :'cutoff_day'::date GROUP BY merchant_id UNION ALL SELECT merchant_id, COUNT(*), SUM(total_amount) FROM orders WHERE created_at >= :'window_start'::timestamp AND created_at < :'first_whole_day'::timestamp GROUP BY merchant_id UNION ALL SELECT merchant_id, COUNT(*), SUM(total_amount) FROM orders WHERE created_at >= :'tail_start'::timestamp AND created_at < :'window_end'::timestamp GROUP BY merchant_id) AS parts GROUP BY merchant_id) SELECT (SELECT count(*) FROM old_t6) AS old_merchants, (SELECT count(*) FROM new_t6) AS new_merchants, (SELECT count(*) FROM (SELECT * FROM old_t6 EXCEPT SELECT * FROM new_t6) AS a) AS only_in_old, (SELECT count(*) FROM (SELECT * FROM new_t6 EXCEPT SELECT * FROM old_t6) AS b) AS only_in_new;
